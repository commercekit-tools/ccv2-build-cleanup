{
  "name": "@commercekit-tools/ccv2-build-cleanup-action",
  "version": "0.0.0",
  "private": true,
  "description": "Safely plan CCv2 build retention cleanup.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "bundle": "ncc build src/index.ts --minify --license licenses.txt -o dist",
    "bundle:check": "node scripts/check-bundle.mjs",
    "audit": "pnpm audit",
    "scan:public": "node scripts/scan-public-files.mjs",
    "quality": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm bundle:check && pnpm metadata:check && pnpm scan:public && pnpm audit",
    "contracts:check": "vitest run tests/contracts",
    "test:e2e": "vitest run tests/e2e",
    "metadata:check": "node scripts/check-metadata.mjs"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@commercekit-tools/ccv2-client": "0.0.3",
    "@commercekit-tools/notification-contract": "0.0.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vercel/ncc": "0.45.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
